    <script>
        function checkQuiz(event) {
            event.preventDefault();
            const options = document.getElementsByName('quiz_opt');
            let selectedValue = "";
            for (let i = 0; i < options.length; i++) {
                if (options[i].checked) {
                    selectedValue = options[i].value;
                    break;
                }
            }

            const resultDiv = document.getElementById('quiz-result');
            if (selectedValue === "olfato") {
                resultDiv.innerHTML = "🎉 Correto! O olfato é o sentido mais poderoso do cão, sendo até 100.000 vezes mais sensível que o nosso!";
                resultDiv.style.color = "#1b5e20";
            } else if (selectedValue === "") {
                resultDiv.innerHTML = "⚠️ Por favor, selecione uma resposta antes de enviar.";
                resultDiv.style.color = "#b71c1c";
            } else {
                resultDiv.innerHTML = "❌ Incorreto! Tente novamente. Dica: Pense no focinho deles!";
                resultDiv.style.color = "#b71c1c";
            }
        }
